# 도로교통공단 OpenAPI 인증키 (지자체별 교통사고 다발지역)
# https://opendata.koroad.or.kr/data/rest/frequentzone/lg?authKey=...
KOROAD_AUTH_KEY=
# 하위 호환 (없으면 DATA_GO_KR_SERVICE_KEY 도 사용)
# DATA_GO_KR_SERVICE_KEY=

# 선택: 캐시 TTL(시간)
# HOTSPOT_CACHE_TTL_HOURS=24
# searchYearCd — 캘린더 연도(2024)가 아니라 요청변수 코드 (예: 2025119)
HOTSPOT_DEFAULT_YEAR=2025119
