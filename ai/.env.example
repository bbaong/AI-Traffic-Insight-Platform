# ============================================
# AI 환경 변수 예시 (FastAPI / uvicorn)
# 사용법: 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
# app/main.py 가 ai/.env 를 load_dotenv 로 읽습니다.
# ============================================

# --------------------------------------------
# 공식 사고다발지역 (GET /hotspots) — 필수
# 도로교통공단 OpenAPI「지자체별 교통사고 다발지역」
# https://opendata.koroad.or.kr/
# --------------------------------------------
KOROAD_AUTH_KEY=your_koroad_auth_key_here
# 하위 호환 (KOROAD_AUTH_KEY 없을 때만)
# DATA_GO_KR_SERVICE_KEY=

# searchYearCd — 캘린더 연도(2024)가 아님 (예: 2025119)
HOTSPOT_DEFAULT_YEAR=2025119
# AI 파일 캐시 TTL(시간). 기본 168=7일
HOTSPOT_CACHE_TTL_HOURS=168

# --------------------------------------------
# PDF 리포트 (선택)
# Cursor 샌드박스 경로 문제를 피할 때 사용
# --------------------------------------------
# AI_PLAYWRIGHT_BROWSERS_PATH=C:\Users\user\AppData\Local\ms-playwright

# --------------------------------------------
# Gov 예측 배치 (선택) — scripts/batch_gov_forecast.py
# 미설정 시 로컬에서 backend/.env 의 DATABASE_URL 을 읽습니다.
# --------------------------------------------
# DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/AI_Traffic_Insight_db"
# GOV_AS_OF=2025Q3
# GOV_FREQ=Q
# GOV_SCOPE=DAEGU