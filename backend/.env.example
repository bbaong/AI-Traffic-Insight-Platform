# ============================================
# Backend 환경 변수 예시
# 사용법: 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
# ============================================

# MySQL / MariaDB (Prisma)
# 형식: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/AI_Traffic_Insight_db"

# AI 추론 서버 (미설정 시 기본값: http://localhost:8000)
AI_SERVICE_URL=http://localhost:8000
# AI 요청 타임아웃(ms) - aiPredict.service.ts 기본값: 20000
AI_TIMEOUT_MS=20000

# 실행 환경 (선택) — development | production
# NODE_ENV=development

# --------------------------------------------
# JWT (로그인/인증용)
# ACCESS/REFRESH 단위: 밀리초
# --------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# --------------------------------------------
# 고객 전화번호 암호화 / 해시 (필수 — base64 디코딩 후 32바이트)
# 생성 예 (Node):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# --------------------------------------------
PHONE_ENCRYPTION_KEY=
PHONE_HASH_PEPPER=

# --------------------------------------------
# 이메일 발송 (SMTP)
# Gmail: 계정 비밀번호가 아니라 앱 비밀번호(16자)를 넣으세요
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="AI Traffic Insight <your-email@gmail.com>"

# --------------------------------------------
# 보험 상담 챗봇 (scripts/ins_chatbot.py)
# pip install -r scripts/requirements-chatbot.txt
# --------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
BACKEND_URL=http://localhost:5000
# users.user_id 숫자 (로그인 성공 시 응답 user_id로 덮어씀, 생략 가능)
INS_CHAT_USER_ID=
# 프론트와 동일: POST /api/user/login { id, password }
INS_CHAT_LOGIN_ID=
INS_CHAT_PASSWORD=
# 선택: 이미 발급된 Access 토큰 (있으면 로그인 생략)
# INS_CHAT_ACCESS_TOKEN=