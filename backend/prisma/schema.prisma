/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model consultations {
  consultation_id                BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id                    BigInt                           @db.UnsignedBigInt
  user_id                        BigInt                           @db.UnsignedBigInt
  profile_id                     BigInt?                          @db.UnsignedBigInt
  memo                           String?                          @db.Text
  status                         consultations_status             @default(IN_PROGRESS)
  consulted_at                   DateTime                         @default(now()) @db.DateTime(0)
  updated_at                     DateTime                         @default(now()) @db.DateTime(0)
  consultation_type              consultations_consultation_type
  consultation_checklist_answers consultation_checklist_answers[]
  consultation_discount_riders   consultation_discount_riders[]
  customers                      customers                        @relation(fields: [customer_id], references: [customer_id], onUpdate: Restrict, map: "fk_consultation_customer")
  customer_risk_profiles         customer_risk_profiles?          @relation(fields: [profile_id], references: [profile_id], onUpdate: Restrict, map: "fk_consultation_profile")
  users                          users                            @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_consultation_user")

  @@index([profile_id], map: "fk_consultation_profile")
  @@index([user_id], map: "fk_consultation_user")
  @@index([customer_id], map: "idx_consultation_customer")
  @@index([consulted_at], map: "idx_consultation_date")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model customer_risk_profiles {
  profile_id                   BigInt                                   @id @default(autoincrement()) @db.UnsignedBigInt
  profile_code                 String                                   @unique(map: "profile_code") @db.VarChar(20)
  based_on_profile_id          BigInt?                                  @db.UnsignedBigInt
  user_id                      BigInt                                   @db.UnsignedBigInt
  customer_memo                String?                                  @db.VarChar(100)
  age_group                    String                                   @db.VarChar(10)
  gender                       customer_risk_profiles_gender
  vehicle_type                 String                                   @default("") @db.VarChar(50)
  district_id                  Int                                      @db.UnsignedInt
  driving_time_slot            customer_risk_profiles_driving_time_slot
  weather_condition            String                                   @db.VarChar(20)
  road_condition               String                                   @db.VarChar(20)
  risk_score                   Decimal                                  @db.Decimal(5, 2)
  risk_grade                   customer_risk_profiles_risk_grade
  severe_injury_probability    Decimal                                  @db.Decimal(5, 2)
  score_diff_vs_cohort_avg     Decimal?                                 @db.Decimal(5, 2)
  percentile_rank              Decimal?                                 @db.Decimal(5, 2)
  sample_size                  Int?                                     @db.UnsignedInt
  is_low_confidence            Boolean                                  @default(false)
  model_version                String                                   @default("customer_score_v1") @db.VarChar(30)
  analyzed_at                  DateTime                                 @default(now()) @db.DateTime(0)
  consultations                consultations[]
  customer_risk_profiles       customer_risk_profiles?                  @relation("customer_risk_profilesTocustomer_risk_profiles", fields: [based_on_profile_id], references: [profile_id], onUpdate: Restrict, map: "fk_profile_based_on")
  other_customer_risk_profiles customer_risk_profiles[]                 @relation("customer_risk_profilesTocustomer_risk_profiles")
  districts                    districts                                @relation(fields: [district_id], references: [district_id], onUpdate: Restrict, map: "fk_profile_district")
  users                        users                                    @relation(fields: [user_id], references: [user_id], onUpdate: Restrict, map: "fk_profile_user")

  @@index([based_on_profile_id], map: "fk_profile_based_on")
  @@index([district_id], map: "fk_profile_district")
  @@index([analyzed_at], map: "idx_profile_analyzed")
  @@index([user_id], map: "idx_profile_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
