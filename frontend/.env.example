# ============================================
# Frontend 환경 변수 예시 (Vite)
# 사용법: 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
# Vite는 VITE_ 접두사 변수만 클라이언트에 노출합니다.
# ============================================

# 백엔드 API 베이스 URL (Express, 기본 localhost:5000)
VITE_API_BASE_URL=http://localhost:5000

# 카카오맵 JavaScript 키 (개발자 콘솔 > 앱 > JavaScript 키)
# GOV 대시보드 지도 로드에 필요합니다.
VITE_KAKAO_MAP_APP_KEY=your_kakao_javascript_key_here